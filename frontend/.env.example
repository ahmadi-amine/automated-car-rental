# Frontend environment — copy to frontend/.env.local (or set as a build arg).
# NEVER commit the real .env.local (it is gitignored).

# Public backend origin the browser calls. NEXT_PUBLIC_* is inlined at BUILD time,
# so it must be set before `next build` (or passed as the Docker build arg
# NEXT_PUBLIC_API_URL). Use the real public API URL in production.
# e.g. https://api.your-domain.com
NEXT_PUBLIC_API_URL=http://localhost:3001
