# Root-level gitignore
# Ignore OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-*

# Temporary files
*.tmp
*.temp
.cache/

# Any other dotenv files
*.env
*.env.local
*.env.*.local

# Environment / secrets — never commit real values (keeps .env.docker, .env, etc. out)
.env
.env.*
!.env.example
