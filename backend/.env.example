# Backend environment — copy this file to backend/.env and fill in real values.
# NEVER commit the real backend/.env (it is gitignored).

# PostgreSQL connection string (e.g. Neon). Include ?sslmode=require for hosted DBs.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# Auth
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Server
PORT=3001

# OpenAI (chatbot, Whisper STT, TTS, embeddings)
OPENAI_API_KEY="sk-your-openai-api-key"

# CORS: comma-separated allowed origins (the web app URL). Leave unset for permissive dev.
# e.g. CORS_ORIGIN="https://app.your-domain.com"
CORS_ORIGIN=

# Public web app base URL — used to build links in emails (e.g. the account
# email-verification link). Defaults to http://localhost:3000 if unset.
APP_URL="http://localhost:3000"

# Email (Gmail SMTP) — sends the client a confirmation when an agency confirms a booking.
# GMAIL_USER: the Gmail address to send from.
# GMAIL_APP_PASSWORD: a 16-char Google "App Password" (requires 2-Step Verification on the
#   account) — NOT your normal Gmail password. Create one at myaccount.google.com > Security.
# Leave GMAIL_APP_PASSWORD empty to disable emails.
GMAIL_USER="youraddress@gmail.com"
GMAIL_APP_PASSWORD=
# The "from" header shown to recipients (must use the GMAIL_USER address).
MAIL_FROM="LuxDrive <youraddress@gmail.com>"
