# Backend environment — copy this file to backend/.env and fill in real values.
# NEVER commit the real backend/.env (it is gitignored).

# PostgreSQL connection string (e.g. Neon). Include ?sslmode=require for hosted DBs.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# Auth
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Server
PORT=3001

# OpenAI (chatbot, Whisper STT, TTS, embeddings)
OPENAI_API_KEY="sk-your-openai-api-key"
