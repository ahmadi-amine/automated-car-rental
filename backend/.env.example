# Backend environment — copy this file to backend/.env and fill in real values.
# NEVER commit the real backend/.env (it is gitignored).

# PostgreSQL connection string (e.g. Neon). Include ?sslmode=require for hosted DBs.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# Auth
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Server
PORT=3001

# OpenAI (chatbot, Whisper STT, TTS, embeddings)
OPENAI_API_KEY="sk-your-openai-api-key"

# CORS: comma-separated allowed origins (the web app URL). Leave unset for permissive dev.
# e.g. CORS_ORIGIN="https://app.your-domain.com"
CORS_ORIGIN=

# Email (Resend) — sends the client a confirmation when an agency confirms a booking.
# Get an API key at https://resend.com. Leave RESEND_API_KEY empty to disable emails.
RESEND_API_KEY=
# The verified "from" address. Use onboarding@resend.dev for testing (delivers only to
# your own Resend account email), or a sender on a domain you verified in Resend.
MAIL_FROM="LuxDrive <onboarding@resend.dev>"
