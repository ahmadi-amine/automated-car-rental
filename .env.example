# Docker Compose environment — copy this file to .env and fill in real values.
# NEVER commit the real .env / .env.docker (they are gitignored).

# PostgreSQL (used by the postgres service and to build DATABASE_URL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_car_rental

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# OpenAI (chatbot, Whisper STT, TTS, embeddings)
OPENAI_API_KEY=sk-your-openai-api-key

# Public backend origin the browser calls (baked into the frontend at build time).
# Use the real public URL in production, e.g. https://api.your-domain.com
NEXT_PUBLIC_API_URL=http://localhost:3001

# Public web app URL — used in email verification links. Set to the real frontend
# URL in production (e.g. https://app.your-domain.com).
APP_URL=http://localhost:3000

# Allowed CORS origin(s), comma-separated (the frontend URL). Leave empty for
# permissive dev; set it in production, e.g. https://app.your-domain.com
CORS_ORIGIN=

# Email (Gmail SMTP) — sends booking + verification emails. Leave GMAIL_APP_PASSWORD
# empty to disable emailing. See backend/.env.example for how to get an App Password.
GMAIL_USER=youraddress@gmail.com
GMAIL_APP_PASSWORD=
MAIL_FROM=LuxDrive <youraddress@gmail.com>
