# Docker Compose environment — copy this file to .env and fill in real values.
# NEVER commit the real .env / .env.docker (they are gitignored).

# PostgreSQL (used by the postgres service and to build DATABASE_URL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_car_rental

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# OpenAI (chatbot, Whisper STT, TTS, embeddings)
OPENAI_API_KEY=sk-your-openai-api-key
